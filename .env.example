# Audiokinetic login for real `satisfactory-modding project init` runs.
# Copy this file to .env, fill in the values, and load it with:
#   set -a; . ./.env; set +a
# The shell reads this file, so keep the quotes. Git ignores .env.
# WWISE_EMAIL and WWISE_PASSWORD (wwise-cli's own names) also work and win
# when both pairs are set.
WWISE_USER="you@example.com"
WWISE_PASS="your-audiokinetic-password"
